# Vercel + Supabase + LINE LIFF 認証 (/api/me) で必要な環境変数
# このファイルをコピーして .env.local を作り、各値を埋める
# 本番値は Vercel Project Settings → Environment Variables に登録すること

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me_service_role_key

# --- LINE ---
# LIFFアプリが紐付いている "LINEログインチャネルID" をカンマ区切りで列挙
# (LIFF ID ではないので注意。LINE Developers Console > Providers > Channels > Basic settings の Channel ID)
LINE_CHANNEL_IDS=1234567890,9876543210

# --- Product ---
# /api/me?product=... が未指定の場合に使われるデフォルト製品コード
# (移行ガード用。Phase 2.x で必須化して廃止予定)
DEFAULT_PRODUCT_CODE=zukai-builder

# --- CORS ---
# /api/me を呼び出して良いオリジンをカンマ区切りで列挙
# 同一オリジン配信のみなら空でも可
ALLOWED_ORIGINS=https://example.vercel.app

# --- AI APIキー (サーバープロキシ用) ---
# 注意: OPENAI_API_KEY / GEMINI_API_KEY は「開発者タグ (pickaxe_internal) 保有者専用」の
#       フォールバックキー。一般ユーザーは自分のキー (BYOK) が必須で、内蔵キーは使えない。
#       設定しなくても一般ユーザーのBYOK利用には影響しない (開発者が内蔵キーで使う場合のみ必要)。
# OpenAI gpt-image-2 / DALL·E 3 (/api/openai-image)
OPENAI_API_KEY=replace_me_openai_key
# Google AI Studio キー (/api/gemini-image)
GEMINI_API_KEY=replace_me_gemini_key
# Straico 内蔵キー (/api/straico)。Straico は開発者専用 (pickaxe_internal タグ必須)。
# 旧実装は app.js に直書きされていたが漏洩リスクのためサーバー側へ移動。旧キーは必ずローテーションすること。
STRAICO_API_KEY=replace_me_straico_key

# --- /pro-max 一時開放キャンペーン ---
# '1' のときだけ X-Temporary-Pro-Max-Access ヘッダによる認証バイパスが有効。
# キャンペーン終了後はこの env var を削除するだけで閉じられる (オプトイン方式)。
ENABLE_TEMP_PRO_MAX_ACCESS=

# --- /pro-agent-unlock 特設ページ (AGENT ティア付与の合言葉) ---
# /pro-agent-unlock ページで入力した合言葉がこの値と一致したとき、ログイン中の LINE
# ユーザーに user_tags へ 'agent' タグを付与する (/api/grant-agent)。
# 未設定だと付与は 503 で閉じる。合言葉を変えるだけで配布を締め切れる。
# 生成例: openssl rand -hex 16
# ※ 旧名 GOD_GRANT_CODE も当面フォールバックとして読まれる (Vercel 側の移行猶予)。
AGENT_GRANT_CODE=replace_me_agent_passphrase

# --- Cron (Storage クリーンアップ) ---
# Vercel Cron が /api/cleanup-storage を叩く際の認証シークレット。
# Vercel が cron 実行時に Authorization: Bearer <CRON_SECRET> を自動付与する。
# 本番では必ず設定すること (未設定だと誰でもこのエンドポイントを叩ける)。
# 生成例: openssl rand -hex 32
CRON_SECRET=replace_me_random_secret

# --- Logging ---
LOG_LEVEL=info
