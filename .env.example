# Vercel + Supabase + LINE LIFF 認証 (/api/me) で必要な環境変数
# このファイルをコピーして .env.local を作り、各値を埋める
# 本番値は Vercel Project Settings → Environment Variables に登録すること

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me_service_role_key

# --- LINE ---
# LIFFアプリが紐付いている "LINEログインチャネルID" をカンマ区切りで列挙
# (LIFF ID ではないので注意。LINE Developers Console > Providers > Channels > Basic settings の Channel ID)
LINE_CHANNEL_IDS=1234567890,9876543210

# --- Product ---
# /api/me?product=... が未指定の場合に使われるデフォルト製品コード
# (移行ガード用。Phase 2.x で必須化して廃止予定)
DEFAULT_PRODUCT_CODE=zukai-builder

# --- CORS ---
# /api/me を呼び出して良いオリジンをカンマ区切りで列挙
# 同一オリジン配信のみなら空でも可
ALLOWED_ORIGINS=https://example.vercel.app

# --- Logging ---
LOG_LEVEL=info
