{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "fluid": true,
  "rewrites": [
    { "source": "/pro-max", "destination": "/index.html" },
    { "source": "/pro-max/", "destination": "/index.html" },
    { "source": "/free", "destination": "/index.html" },
    { "source": "/free/", "destination": "/index.html" },
    { "source": "/line-menu", "destination": "/line-menu.html" },
    { "source": "/line-menu/", "destination": "/line-menu.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
