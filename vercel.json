{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/me.js": {
      "maxDuration": 10
    },
    "api/upload-character-image.js": {
      "maxDuration": 10
    },
    "api/pickaxe-proxy.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/pro-max", "destination": "/index.html" },
    { "source": "/pro-max/", "destination": "/index.html" },
    { "source": "/free", "destination": "/index.html" },
    { "source": "/free/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
