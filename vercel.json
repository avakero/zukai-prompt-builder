{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "fluid": true,
  "functions": {
    "api/openai-image.js":    { "maxDuration": 180 },
    "api/gemini-image.js":    { "maxDuration": 180 },
    "api/pickaxe-proxy.js":   { "maxDuration": 300 },
    "api/straico.js":         { "maxDuration": 120 },
    "api/cleanup-storage.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cleanup-storage", "schedule": "0 18 * * *" }
  ],
  "rewrites": [
    { "source": "/pro-max", "destination": "/index.html" },
    { "source": "/pro-max/", "destination": "/index.html" },
    { "source": "/pro-agent", "destination": "/index.html" },
    { "source": "/pro-agent/", "destination": "/index.html" },
    { "source": "/solo", "destination": "/index.html" },
    { "source": "/solo/", "destination": "/index.html" },
    { "source": "/pro-agent-unlock", "destination": "/pro-agent-unlock.html" },
    { "source": "/pro-agent-unlock/", "destination": "/pro-agent-unlock.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" }
  ],
  "redirects": [
    { "source": "/god-max", "destination": "/pro-agent", "permanent": false },
    { "source": "/god-max/", "destination": "/pro-agent", "permanent": false },
    { "source": "/god", "destination": "/pro-agent-unlock", "permanent": false },
    { "source": "/god/", "destination": "/pro-agent-unlock", "permanent": false },
    { "source": "/line-menu", "destination": "https://line-menu-builder.vercel.app/", "permanent": false },
    { "source": "/line-menu/", "destination": "https://line-menu-builder.vercel.app/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
